{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipHist",
  "version": "1.0.0",
  "identifier": "com.ping.cliphist",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ClipHist",
        "width": 400,
        "height": 600,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "minimizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {}
}
